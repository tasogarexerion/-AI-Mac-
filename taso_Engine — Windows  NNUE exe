#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import sys
import subprocess
import time
import math
import random
import re
import threading
import queue
from typing import Dict, Optional, List, Tuple

# =========================================================
# TASO Engine — Windows / NNUE exe Wrapper (Hysteresis)
#
# Fixes:
# - Forward child "usi" output fully (option lines included)
# - Wait for child "readyok" (prevents desync after moves)
# - On timeout: send "stop" and still drain until "bestmove"
#
# Policy:
#   Short mate > Hisshi > Stable win > Annoying loss
#   + Hysteresis on "mode" using humanscore internally
# =========================================================

ENGINE_EXE = os.environ.get(
    "TASO_ENGINE_EXE",
    r"C:\shogi\engines\nnue_engine\nnue_engine.exe"
)

TASO_SHOW  = os.environ.get("TASO_SHOW",  "1") == "1"
TASO_DEBUG = os.environ.get("TASO_DEBUG", "0") == "1"

TASO_THREADS = int(os.environ.get("TASO_THREADS", "8"))
TASO_HASH_MB = int(os.environ.get("TASO_HASH_MB", "1024"))
TASO_MULTIPV = int(os.environ.get("TASO_MULTIPV", "3"))

# --- humanscore curve ---
ENDGAME_CP = int(os.environ.get("TASO_ENDGAME_CP", "800"))

# --- mate / hisshi ---
TASO_SHORT_MATE_MAX    = int(os.environ.get("TASO_SHORT_MATE_MAX", "7"))
TASO_LONG_MATE_IGNORE  = int(os.environ.get("TASO_LONG_MATE_IGNORE", "10"))
TASO_HISSHI_PREFIX_MIN = int(os.environ.get("TASO_HISSHI_PREFIX_MIN", "2"))
TASO_HISSHI_MAX_DROP   = int(os.environ.get("TASO_HISSHI_MAX_DROP", "120"))
TASO_HISSHI_MIN_LINES  = int(os.environ.get("TASO_HISSHI_MIN_LINES", "2"))

# --- selection knobs ---
TASO_STABLE_DROP    = int(os.environ.get("TASO_STABLE_DROP", "120"))
TASO_PREFIX_K       = int(os.environ.get("TASO_PREFIX_K", "4"))
TASO_ANNOY_MAX_DROP = int(os.environ.get("TASO_ANNOY_MAX_DROP", "180"))

# --- hysteresis thresholds (humanscore based) ---
# default: enter "win" >= 0.70, exit "win" <= 0.62
#          enter "loss"<= 0.30, exit "loss">= 0.38
HS_WIN_ENTER  = float(os.environ.get("TASO_HS_WIN_ENTER",  "0.70"))
HS_WIN_EXIT   = float(os.environ.get("TASO_HS_WIN_EXIT",   "0.62"))
HS_LOSE_ENTER = float(os.environ.get("TASO_HS_LOSE_ENTER", "0.30"))
HS_LOSE_EXIT  = float(os.environ.get("TASO_HS_LOSE_EXIT",  "0.38"))

# IO safety
READ_TIMEOUT   = float(os.environ.get("TASO_READ_TIMEOUT", "0.5"))
GO_TIMEOUT_SEC = float(os.environ.get("TASO_GO_TIMEOUT", "10.0"))
LINE_LIMIT     = int(os.environ.get("TASO_LINE_LIMIT", "6000"))

# deterministic randomness
_seed = os.environ.get("TASO_SEED")
if _seed:
    try:
        random.seed(int(_seed))
    except Exception:
        pass

_INT_RE = re.compile(r"^-?\d+$")

def out(s: str) -> None:
    sys.stdout.write(s + "\n")
    sys.stdout.flush()

def dbg(s: str) -> None:
    if TASO_DEBUG:
        sys.stderr.write("[TASO] " + s + "\n")
        sys.stderr.flush()

def say(s: str) -> None:
    if TASO_SHOW:
        out("info string " + s)

def is_int(s: str) -> bool:
    return bool(_INT_RE.match(s))

def clamp(x: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, x))

def human_score(cp: int) -> float:
    x = cp / 450.0
    h = 1.0 / (1.0 + math.exp(-x))
    if abs(cp) >= ENDGAME_CP:
        h = 0.5 + (h - 0.5) * 0.6
    return clamp(h, 0.01, 0.99)

def common_prefix_len(a: str, b: str, k: int) -> int:
    aa, bb = a.split(), b.split()
    for i in range(min(k, len(aa), len(bb))):
        if aa[i] != bb[i]:
            return i
    return min(k, len(aa), len(bb))

def parse_mate(m: Optional[str]) -> Optional[int]:
    try:
        return int(m) if m is not None else None
    except Exception:
        return None

def turn_sign_from_position(line: str) -> int:
    t = line.split()
    if len(t) < 2:
        return 1
    if t[1] == "startpos":
        if "moves" in t:
            c = len(t) - t.index("moves") - 1
            return 1 if c % 2 == 0 else -1
        return 1
    if t[1] == "sfen":
        for x in t[2:]:
            if x == "b":
                return 1
            if x == "w":
                return -1
    return 1

class ChildEngine:
    def __init__(self, exe: str) -> None:
        flags = 0x08000000 if os.name == "nt" else 0  # CREATE_NO_WINDOW
        self.proc = subprocess.Popen(
            [exe],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            bufsize=1,
            creationflags=flags,
        )
        if not self.proc.stdin or not self.proc.stdout:
            raise RuntimeError("failed to open pipes")

        self.q: "queue.Queue[str]" = queue.Queue()
        self.stop_evt = threading.Event()
        self.t = threading.Thread(target=self._reader, daemon=True)
        self.t.start()

    def _reader(self) -> None:
        try:
            assert self.proc.stdout is not None
            for line in self.proc.stdout:
                if self.stop_evt.is_set():
                    break
                self.q.put(line.rstrip("\n"))
        except Exception:
            pass

    def send(self, s: str) -> None:
        try:
            if self.proc.stdin:
                self.proc.stdin.write(s + "\n")
                self.proc.stdin.flush()
        except Exception:
            pass

    def readline(self, timeout: float) -> Optional[str]:
        try:
            return self.q.get(timeout=timeout)
        except queue.Empty:
            return None

    def flush(self) -> None:
        while True:
            try:
                self.q.get_nowait()
            except queue.Empty:
                return

    def close(self) -> None:
        try:
            self.stop_evt.set()
            self.send("quit")
        except Exception:
            pass
        try:
            self.proc.terminate()
        except Exception:
            pass

class PVStore:
    def __init__(self) -> None:
        self.move: Dict[int, str] = {}
        self.cp: Dict[int, int] = {}
        self.mate: Dict[int, str] = {}
        self.pv: Dict[int, str] = {}
        self.depth: Dict[int, int] = {}

    def reset(self) -> None:
        self.move.clear()
        self.cp.clear()
        self.mate.clear()
        self.pv.clear()
        self.depth.clear()

    def snap(self, mpv: int, depth: int,
             mv: Optional[str], pv: Optional[str],
             cp: Optional[int], mate: Optional[str]) -> None:
        if depth < self.depth.get(mpv, -1):
            return
        self.depth[mpv] = depth
        if mv:
            self.move[mpv] = mv
        if pv:
            self.pv[mpv] = pv
        if cp is not None:
            self.cp[mpv] = cp
        if mate:
            self.mate[mpv] = mate

def is_hisshi(pvs: PVStore) -> bool:
    if 1 not in pvs.pv or 1 not in pvs.cp:
        return False
    base_pv, base_cp = pvs.pv[1], pvs.cp[1]
    hits = 0
    for i in range(2, TASO_MULTIPV + 1):
        pv, cp = pvs.pv.get(i), pvs.cp.get(i)
        if not pv or cp is None:
            continue
        if (common_prefix_len(base_pv, pv, TASO_PREFIX_K) >= TASO_HISSHI_PREFIX_MIN
            and abs(base_cp - cp) <= TASO_HISSHI_MAX_DROP):
            hits += 1
    return hits >= TASO_HISSHI_MIN_LINES

def pick_stable(pvs: PVStore) -> Optional[str]:
    base_cp = pvs.cp.get(1, 0)
    base_pv = pvs.pv.get(1, "")
    best, best_score = pvs.move.get(1), -10**9
    for i in range(1, TASO_MULTIPV + 1):
        mv, cp, pv = pvs.move.get(i), pvs.cp.get(i), pvs.pv.get(i, "")
        if not mv or cp is None:
            continue
        drop = max(0, base_cp - cp)
        if drop > TASO_STABLE_DROP:
            continue
        score = -drop + common_prefix_len(base_pv, pv, TASO_PREFIX_K) * 5
        if score > best_score:
            best, best_score = mv, score
    return best

def pick_annoy(pvs: PVStore) -> Optional[str]:
    base_cp = pvs.cp.get(1, 0)
    base_pv = pvs.pv.get(1, "")
    best_score, cand = -10**9, []
    for i in range(2, TASO_MULTIPV + 1):
        mv, cp, pv = pvs.move.get(i), pvs.cp.get(i), pvs.pv.get(i, "")
        if not mv or cp is None:
            continue
        drop = base_cp - cp
        if drop > TASO_ANNOY_MAX_DROP:
            continue
        pref = common_prefix_len(base_pv, pv, TASO_PREFIX_K)
        score = (TASO_PREFIX_K - pref) * 10
        if pref == 2:
            score += 40
        elif pref == 1:
            score += 18
        if score > best_score:
            best_score, cand = score, [mv]
        elif score == best_score:
            cand.append(mv)
    return random.choice(cand) if cand else pvs.move.get(1)

def parse_info_line(tokens: List[str], turn: int) -> Tuple[int, int, Optional[int], Optional[str], Optional[str], Optional[str]]:
    mpv = 1
    depth = 0
    cp = None
    mate = None
    mv = None
    pvline = None

    if "multipv" in tokens:
        try:
            mpv = int(tokens[tokens.index("multipv") + 1])
        except Exception:
            pass
    if "depth" in tokens:
        try:
            depth = int(tokens[tokens.index("depth") + 1])
        except Exception:
            pass
    if "pv" in tokens:
        i = tokens.index("pv")
        if i + 1 < len(tokens):
            pv_tokens = tokens[i + 1 :]
            pvline = " ".join(pv_tokens)
            mv = pv_tokens[0] if pv_tokens else None

    if "score" in tokens and "cp" in tokens:
        j = tokens.index("cp")
        if j + 1 < len(tokens) and is_int(tokens[j + 1]):
            cp = int(tokens[j + 1]) * turn

    if "mate" in tokens:
        j = tokens.index("mate")
        if j + 1 < len(tokens):
            mate = tokens[j + 1]

    return mpv, depth, cp, mate, mv, pvline

# --- hysteresis state ---
class Mode:
    NEUTRAL = "neutral"
    WIN = "win"
    LOSE = "lose"

def hysteresis_update(mode: str, hs: float) -> str:
    if mode == Mode.NEUTRAL:
        if hs >= HS_WIN_ENTER:
            return Mode.WIN
        if hs <= HS_LOSE_ENTER:
            return Mode.LOSE
        return Mode.NEUTRAL
    if mode == Mode.WIN:
        if hs <= HS_WIN_EXIT:
            return Mode.NEUTRAL
        return Mode.WIN
    if mode == Mode.LOSE:
        if hs >= HS_LOSE_EXIT:
            return Mode.NEUTRAL
        return Mode.LOSE
    return Mode.NEUTRAL

def main() -> None:
    if not os.path.isfile(ENGINE_EXE):
        out("id name TASO (engine missing)")
        out("id author taso")
        out("usiok")
        return

    eng = ChildEngine(ENGINE_EXE)
    pvs = PVStore()
    turn = 1
    last_pos = "position startpos"
    mode = Mode.NEUTRAL

    def apply_opts() -> None:
        eng.send(f"setoption name Threads value {TASO_THREADS}")
        # Hash names differ by engine; harmless if unknown
        eng.send(f"setoption name USI_Hash value {TASO_HASH_MB}")
        eng.send(f"setoption name Hash value {TASO_HASH_MB}")
        eng.send(f"setoption name HashSize value {TASO_HASH_MB}")
        eng.send(f"setoption name MultiPV value {TASO_MULTIPV}")

    def wait_until(prefix: str, timeout_sec: float) -> bool:
        t0 = time.time()
        while time.time() - t0 < timeout_sec:
            r = eng.readline(READ_TIMEOUT)
            if r is None:
                continue
            # forward any noise; GUIs generally tolerate it
            out(r)
            if r.startswith(prefix):
                return True
        return False

    try:
        for raw in sys.stdin:
            line = raw.strip()
            if not line:
                continue

            # --- USI handshake: forward child output fully (option included) ---
            if line == "usi":
                eng.flush()
                eng.send("usi")

                # Forward everything until child's usiok.
                # But swap id lines to our wrapper identity.
                seen_usiok = False
                t0 = time.time()
                while time.time() - t0 < 5.0:
                    r = eng.readline(READ_TIMEOUT)
                    if r is None:
                        continue
                    if r.startswith("id name") or r.startswith("id author"):
                        # drop child's identity
                        continue
                    out(r)
                    if r.startswith("usiok"):
                        seen_usiok = True
                        break

                # Now announce wrapper identity (keep child's options already forwarded)
                out("id name TASO (Hysteresis Wrapper)")
                out("id author taso")
                # If child usiok wasn't seen (rare), still complete handshake
                if not seen_usiok:
                    out("usiok")

                apply_opts()
                continue

            # --- isready: must wait for child's readyok to avoid desync ---
            if line == "isready":
                eng.flush()
                eng.send("isready")

                # Forward lines until readyok (or timeout)
                t0 = time.time()
                got = False
                while time.time() - t0 < 5.0:
                    r = eng.readline(READ_TIMEOUT)
                    if r is None:
                        continue
                    if r.startswith("readyok"):
                        got = True
                        break
                    out(r)
                out("readyok" if got else "readyok")
                continue

            # --- pass-through commands that matter for GUI cycles ---
            if line.startswith("setoption"):
                eng.send(line)
                continue

            if line.startswith("usinewgame"):
                eng.send(line)
                apply_opts()
                continue

            if line.startswith("stop"):
                eng.send("stop")
                continue

            if line.startswith("ponderhit"):
                eng.send(line)
                continue

            if line.startswith("position"):
                last_pos = line
                turn = turn_sign_from_position(line)
                eng.send(line)
                continue

            if line.startswith("go"):
                pvs.reset()
                eng.flush()

                # In case some GUIs omit position before go
                eng.send(last_pos)
                eng.send(line)

                best_engine: Optional[str] = None
                humanscore_sent = False
                start = time.time()
                stopped = False

                for _ in range(LINE_LIMIT):
                    if time.time() - start > GO_TIMEOUT_SEC and not stopped:
                        eng.send("stop")
                        stopped = True
                        # don't break yet: we want bestmove
                    r = eng.readline(READ_TIMEOUT)
                    if r is None:
                        continue

                    if r.startswith("info"):
                        out(r)
                        if "humanscore" in r:
                            humanscore_sent = True
                        mpv, depth, cp, mate, mv, pv = parse_info_line(r.split(), turn)
                        pvs.snap(mpv, depth, mv, pv, cp, mate)
                        continue

                    if r.startswith("bestmove"):
                        parts = r.split()
                        best_engine = parts[1] if len(parts) >= 2 else None
                        break

                    # Forward anything else just in case
                    out(r)

                # Ensure humanscore exactly once
                cp1 = pvs.cp.get(1, 0)
                hs = human_score(cp1)
                if not humanscore_sent:
                    out(f"info string humanscore={hs:.2f}")

                # Update hysteresis mode using humanscore
                old_mode = mode
                mode = hysteresis_update(mode, hs)
                if mode != old_mode:
                    say(f"mode {old_mode} -> {mode} (humanscore {hs:.2f})")

                override = best_engine or "resign"

                # Short mate priority (winning mate only)
                best_len, best_mv = None, None
                for i, mstr in pvs.mate.items():
                    mt = parse_mate(mstr)
                    mv = pvs.move.get(i)
                    if mt is None or mv is None:
                        continue
                    if mt <= 0:
                        continue
                    if best_len is None or mt < best_len:
                        best_len, best_mv = mt, mv

                if best_len is not None and best_len <= TASO_SHORT_MATE_MAX:
                    say(f"⚡ short-mate priority (mate {best_len})")
                    override = best_mv or override
                else:
                    # Hisshi gate: ignore if there is only long mate lines
                    has_long_mate = False
                    for mstr in pvs.mate.values():
                        mt = parse_mate(mstr)
                        if mt is not None and mt > TASO_LONG_MATE_IGNORE:
                            has_long_mate = True
                            break

                    if is_hisshi(pvs) and not has_long_mate:
                        say("🔒 hisshi priority")
                        override = pick_stable(pvs) or override
                    else:
                        # Mode-driven choice (hysteresis)
                        if mode == Mode.WIN:
                            say("🧱 stable win (hysteresis)")
                            override = pick_stable(pvs) or override
                        elif mode == Mode.LOSE:
                            say("🪤 annoying loss (hysteresis)")
                            override = pick_annoy(pvs) or override
                        else:
                            # neutral: keep engine bestmove
                            pass

                out(f"bestmove {override}")
                apply_opts()
                continue

            if line == "quit":
                break

            # default passthrough
            eng.send(line)

    finally:
        eng.close()

if __name__ == "__main__":
    main()
