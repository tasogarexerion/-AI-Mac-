# ---------------------------------------------------------
# IO helpers (BrokenPipe-safe)
# ---------------------------------------------------------
def out(s: str) -> None:
    try:
        sys.stdout.write(s + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        try:
            sys.exit(0)
        except SystemExit:
            raise

def dbg(s: str) -> None:
    if TASO_DEBUG:
        try:
            sys.stderr.write("[TASO] " + s + "\n")
            sys.stderr.flush()
        except Exception:
            pass

def say(s: str) -> None:
    if TASO_SHOW:
        out("info string " + s)

# ---------------------------------------------------------
# Utility helpers
# ---------------------------------------------------------
_INT_RE = re.compile(r"^-?\d+$")

def is_int(s: str) -> bool:
    return bool(_INT_RE.match(s))

def clamp(x: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, x))

def human_score(cp: int) -> float:
    # cp is side-to-move view
    x = cp / 1100.0
    h = 1.0 / (1.0 + math.exp(-x))
    if abs(cp) >= ENDGAME_CP:
        h = 0.5 + (h - 0.5) * 1.3
    return clamp(h, 0.05, 0.95)

def common_prefix_len(a: str, b: str, k: int) -> int:
    aa, bb = a.split(), b.split()
    for i in range(min(k, len(aa), len(bb))):
        if aa[i] != bb[i]:
            return i
    return min(k, len(aa), len(bb))

def parse_mate(m: Optional[str]) -> Optional[int]:
    if m is None:
        return None
    try:
        return int(m)
    except Exception:
        return None

def stm_sign_from_position(line: str) -> int:
    """
    +1 : black/sente to move
    -1 : white/gote to move
    """
    toks = line.split()
    if "startpos" in toks and "moves" in toks:
        mc = len(toks) - toks.index("moves") - 1
        return 1 if mc % 2 == 0 else -1
    if "sfen" in toks:
        i = toks.index("sfen")
        if len(toks) > i + 2:
            return 1 if toks[i + 2] == "b" else -1
    return 1

def _parse_go_hard_limit_sec(go_line: str) -> float:
    toks = go_line.split()
    if "byoyomi" in toks:
        i = toks.index("byoyomi")
        if i + 1 < len(toks) and is_int(toks[i + 1]):
            ms = int(toks[i + 1])
            return max(1.0, ms / 1000.0) + GO_HARD_MARGIN_SEC
    bt = None
    wt = None
    if "btime" in toks:
        i = toks.index("btime")
        if i + 1 < len(toks) and is_int(toks[i + 1]):
            bt = int(toks[i + 1])
    if "wtime" in toks:
        i = toks.index("wtime")
        if i + 1 < len(toks) and is_int(toks[i + 1]):
            wt = int(toks[i + 1])
    if bt is not None or wt is not None:
        ms = min([v for v in [bt, wt] if v is not None])
        return max(1.0, ms / 1000.0) + GO_HARD_MARGIN_SEC
    return GO_DEFAULT_HARD_SEC

# ---------------------------------------------------------
# HumanScore hysteresis state
# ---------------------------------------------------------
class HysteresisState:
    def __init__(self) -> None:
        self.mode = MODE_NORMAL
        self.last_cp: Optional[int] = None

    def update(self, cp: int) -> str:
        # cp は「手番側視点」の評価
        if self.last_cp is None:
            self.last_cp = cp
            return self.mode

        delta = cp - self.last_cp
        self.last_cp = cp

        # --- 毒饅頭（POISON）ヒステリシス ---
        if self.mode == MODE_POISON:
            if cp >= POISON_EXIT or delta >= POISON_RECOVER_DELTA:
                self.mode = MODE_NORMAL
            else:
                return self.mode
        else:
            if cp <= POISON_ENTER:
                self.mode = MODE_POISON
                return self.mode

        # --- 通常ヒステリシス ---
        hs = human_score(cp)

        if self.mode == MODE_NORMAL:
            if hs >= HS_STABLE_ENTER:
                self.mode = MODE_STABLE
            elif hs <= HS_ANNOY_ENTER:
                self.mode = MODE_ANNOY

        elif self.mode == MODE_STABLE:
            if hs <= HS_STABLE_EXIT:
                self.mode = MODE_NORMAL

        elif self.mode == MODE_ANNOY:
            if delta >= POISON_RECOVER_DELTA:
                self.mode = MODE_NORMAL
            elif hs >= HS_ANNOY_EXIT:
                self.mode = MODE_NORMAL

        return self.mode

# ---------------------------------------------------------
# Child engine (ReaderThread safe) + CWD FIX
# ---------------------------------------------------------
class ChildEngine:
    def __init__(self, cmd: List[str]) -> None:
        exe = cmd[0]
        engine_cwd = os.path.dirname(os.path.abspath(exe)) if exe else None
        self.proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            bufsize=1,
            cwd=engine_cwd,
        )
        self.q: queue.Queue[str] = queue.Queue()
        self.alive = True
        self.t = threading.Thread(target=self._reader, daemon=True)
        self.t.start()

    def _reader(self) -> None:
        assert self.proc.stdout
        for line in self.proc.stdout:
            self.q.put(line.rstrip("\n"))
        self.alive = False

    def send(self, s: str) -> None:
        if self.proc.stdin:
            try:
                self.proc.stdin.write(s + "\n")
                self.proc.stdin.flush()
            except Exception:
                pass

    def recv(self, timeout: float) -> Optional[str]:
        try:
            return self.q.get(timeout=timeout)
        except queue.Empty:
            return None

    def close(self) -> None:
        try:
            self.send("quit")
        except Exception:
            pass
        try:
            self.proc.terminate()
        except Exception:
            pass

# ---------------------------------------------------------
# PV store
# ---------------------------------------------------------
class PVStore:
    def __init__(self) -> None:
        self.move: Dict[int, str] = {}
        self.cp: Dict[int, int] = {}
        self.mate: Dict[int, str] = {}
        self.depth: Dict[int, int] = {}
        self.pvline: Dict[int, str] = {}

    def reset(self) -> None:
        self.move.clear()
        self.cp.clear()
        self.mate.clear()
        self.depth.clear()
        self.pvline.clear()

    def snapshot(
        self,
        mpv: int,
        depth: int,
        mv: Optional[str],
        pv: Optional[str],
        cp: Optional[int],
        mate: Optional[str],
    ) -> None:
        if depth < self.depth.get(mpv, -1):
            return
        self.depth[mpv] = depth
        if mv:
            self.move[mpv] = mv
        if pv:
            self.pvline[mpv] = pv
        if cp is not None:
            self.cp[mpv] = cp
        if mate is not None:
            self.mate[mpv] = mate

# ---------------------------------------------------------
# Hisshi detection
# ---------------------------------------------------------
def is_hisshi_position(pvs: PVStore) -> bool:
    if 1 not in pvs.pvline or 1 not in pvs.cp:
        return False
    pv1 = pvs.pvline[1]
    cp1 = pvs.cp[1]
    hits = 0
    for i in range(2, TASO_MULTIPV + 1):
        pv = pvs.pvline.get(i)
        cp = pvs.cp.get(i)
        if not pv or cp is None:
            continue
        if common_prefix_len(pv1, pv, TASO_PREFIX_K) >= TASO_HISSHI_PREFIX_MIN \
           and abs(cp1 - cp) <= TASO_HISSHI_MAX_DROP:
            hits += 1
    return hits >= TASO_HISSHI_MIN_LINES

# ---------------------------------------------------------
# Safe move filter (avoid self-mate)
# ---------------------------------------------------------
def filter_safe_moves(pvs: PVStore) -> PVStore:
    """
    Remove moves that lead to immediate self-mate (mate < 0).
    - If a PV line has no mate info, treat it as safe.
    - If all PVs look losing by mate, return original pvs.
    """
    safe_indices = set()
    for i in pvs.move.keys():
        m = pvs.mate.get(i)
        if m is None:
            safe_indices.add(i)
            continue
        try:
            if int(m) >= 0:
                safe_indices.add(i)
        except Exception:
            safe_indices.add(i)

    if not safe_indices:
        return pvs

    new = PVStore()
    for i in safe_indices:
        if i in pvs.move:
            new.move[i] = pvs.move[i]
        if i in pvs.cp:
            new.cp[i] = pvs.cp[i]
        if i in pvs.pvline:
            new.pvline[i] = pvs.pvline[i]
        if i in pvs.mate:
            new.mate[i] = pvs.mate[i]
        if i in pvs.depth:
            new.depth[i] = pvs.depth[i]

    return new

# ---------------------------------------------------------
# Move selection
# ---------------------------------------------------------
def pick_stable_winning_move(pvs: PVStore) -> Optional[str]:
    cp1 = pvs.cp.get(1, 0)
    pv1 = pvs.pvline.get(1, "")
    best = pvs.move.get(1)
    best_score = -10**9
    for i in range(1, TASO_MULTIPV + 1):
        mv = pvs.move.get(i)
        cp = pvs.cp.get(i)
        pv = pvs.pvline.get(i, "")
        if not mv or cp is None:
            continue
        drop = max(0, cp1 - cp)
        if drop > TASO_STABLE_DROP:
            continue
        score = -drop + common_prefix_len(pv1, pv, TASO_PREFIX_K) * 5
        if score > best_score:
            best_score = score
            best = mv
    return best

def pick_annoying_losing_move(pvs: PVStore) -> Optional[str]:
    cp1 = pvs.cp.get(1, 0)
    pv1 = pvs.pvline.get(1, "")
    best_score = -10**9
    cand: List[str] = []
    for i in range(2, TASO_MULTIPV + 1):
        mv = pvs.move.get(i)
        cp = pvs.cp.get(i)
        pv = pvs.pvline.get(i, "")
        if not mv or cp is None:
            continue
        drop = cp1 - cp
        if drop > TASO_ANNOY_MAX_DROP:
            continue
        pref = common_prefix_len(pv1, pv, TASO_PREFIX_K)
        score = (TASO_PREFIX_K - pref) * 10
        if pref == 2:
            score += 40
        if pref == 1:
            score += 18
        if score > best_score:
            best_score = score
            cand = [mv]
        elif score == best_score:
            cand.append(mv)
    return random.choice(cand) if cand else pvs.move.get(1)

def pick_poison_move(pvs: PVStore) -> Optional[str]:
    """
    "毒饅頭": ほんの少し評価を落として分岐を作り、
    相手に判断を要求する（= 人間相手に勝ちやすい）方向の手を選ぶ。

    前提:
    - cp は「手番側視点」の評価。
    """
    base_cp = pvs.cp.get(1, 0)
    base_pv = pvs.pvline.get(1, "")

    best_score = -1.0e18
    best_move: Optional[str] = None

    for i in range(2, TASO_MULTIPV + 1):
        mv = pvs.move.get(i)
        cp = pvs.cp.get(i)
        pv = pvs.pvline.get(i, "")

        if not mv or cp is None or not pv:
            continue

        if cp < TASO_POISON_MIN_CP:
            continue

        drop = max(0, base_cp - cp)
        if drop > TASO_POISON_MAX_DROP:
            continue

        divergence = TASO_PREFIX_K - common_prefix_len(base_pv, pv, TASO_PREFIX_K)

        score = (
            divergence * 50.0
            + drop * 0.5
            - abs(cp) * 0.05
        )

        if score > best_score:
            best_score = score
            best_move = mv

    return best_move or pvs.move.get(1)

# ---------------------------------------------------------
# Main USI loop
# ---------------------------------------------------------
def main() -> None:
    fuka = os.path.expanduser(FUKA_BIN)

    if not os.path.isfile(fuka):
        out("id name TASO (fukauraou missing)")
        out("id author taso")
        out("usiok")
        return

    eng = ChildEngine([fuka])
    pvs = PVStore()
    hys = HysteresisState()
    stm_sign = 1  # +1 black-to-move, -1 white-to-move

    def apply_opts() -> None:
        eng.send(f"setoption name Threads value {TASO_THREADS}")
        eng.send(f"setoption name USI_Hash value {TASO_HASH_MB}")
        # aliases (some engines accept, some reject; harmless)
        eng.send(f"setoption name Hash value {TASO_HASH_MB}")
        eng.send(f"setoption name HashSize value {TASO_HASH_MB}")
        eng.send(f"setoption name MultiPV value {TASO_MULTIPV}")

    try:
        for raw in sys.stdin:
            line = raw.strip()
            if not line:
                continue

            if line == "usi":
                eng.send("usi")
                while True:
                    o = eng.recv(READ_TIMEOUT_SEC)
                    if o is None:
                        continue
                    out(o)
                    if o.startswith("usiok"):
                        break
                apply_opts()
                continue

            if line == "isready":
                eng.send("isready")
                t0 = time.time()
                got = False
                while time.time() - t0 < 10.0:
                    o = eng.recv(READ_TIMEOUT_SEC)
                    if not o:
                        continue
                    if o.startswith("info"):
                        out(o)
                    if o.startswith("readyok"):
                        got = True
                        break
                out("readyok" if got else "readyok")
                continue

            if line.startswith("position"):
                stm_sign = stm_sign_from_position(line)
                eng.send(line)
                continue

            if line.startswith("setoption"):
                eng.send(line)
                continue

            if line.startswith("go"):
                pvs.reset()
                eng.send(line)

                hard_limit = _parse_go_hard_limit_sec(line)
                t_start = time.time()
                last_rx = time.time()
                sent_stop = False

                best_engine: Optional[str] = None

                for _ in range(LINE_LIMIT):
                    now = time.time()
                    if now - t_start > hard_limit:
                        if not sent_stop:
                            eng.send("stop")
                            sent_stop = True
                        break

                    o = eng.recv(READ_TIMEOUT_SEC)
                    if o is None:
                        if (now - last_rx) >= GO_SILENCE_STOP_SEC and not sent_stop:
                            eng.send("stop")
                            sent_stop = True
                        continue

                    last_rx = time.time()

                    if o.startswith("info"):
                        out(o)
                        toks = o.split()

                        mpv = 1
                        depth = 0
                        cp: Optional[int] = None
                        mate: Optional[str] = None
                        pv: Optional[str] = None
                        mv: Optional[str] = None

                        if "multipv" in toks:
                            i = toks.index("multipv")
                            if i + 1 < len(toks) and is_int(toks[i + 1]):
                                mpv = int(toks[i + 1])

                        if "depth" in toks:
                            i = toks.index("depth")
                            if i + 1 < len(toks) and is_int(toks[i + 1]):
                                depth = int(toks[i + 1])

                        if "pv" in toks:
                            i = toks.index("pv")
                            if i + 1 < len(toks):
                                pv = " ".join(toks[i + 1 :])
                                mv = toks[i + 1]

                        # score cp
                        if "score" in toks and "cp" in toks:
                            j = toks.index("cp")
                            if j + 1 < len(toks) and is_int(toks[j + 1]):
                                raw_cp = int(toks[j + 1])
                                if TASO_SCORE_PERSPECTIVE == "black":
                                    cp = raw_cp * stm_sign  # black-perspective -> side-to-move
                                else:
                                    cp = raw_cp            # already side-to-move

                        if "mate" in toks:
                            j = toks.index("mate")
                            if j + 1 < len(toks):
                                mate = toks[j + 1]

                        pvs.snapshot(mpv, depth, mv, pv, cp, mate)
                        continue

                    if o.startswith("bestmove"):
                        parts = o.split()
                        if len(parts) >= 2:
                            best_engine = parts[1]
                        break

                    out(o)

                # Decide (override) based on PV snapshot
                cp1 = pvs.cp.get(1, 0)  # side-to-move view
                hs = human_score(cp1)
                mode = hys.update(cp1)

                pvs = filter_safe_moves(pvs)

                black_cp = cp1 if stm_sign == 1 else -cp1
                out(f"info string cp(stm)={cp1:+d} cp(black)={black_cp:+d} humanscore={hs:.2f} mode={mode}")

                override = best_engine or "resign"

                # Short mate priority
                best_short: Optional[Tuple[int, str]] = None
                for i, m in pvs.mate.items():
                    mt = parse_mate(m)
                    mv = pvs.move.get(i)
                    if mt is not None and mt > 0 and mv:
                        if best_short is None or mt < best_short[0]:
                            best_short = (mt, mv)

                if best_short and best_short[0] <= TASO_SHORT_MATE_MAX:
                    say(f"⚡ short-mate priority (mate {best_short[0]})")
                    override = best_short[1]
                else:
                    has_long_mate = any(
                        (mt := parse_mate(m)) is not None and mt > TASO_LONG_MATE_IGNORE
                        for m in pvs.mate.values()
                    )

                    if is_hisshi_position(pvs) and not has_long_mate:
                        say("🔒 hisshi priority")
                        override = pick_stable_winning_move(pvs) or override
                    elif mode == MODE_STABLE:
                        say("🧱 stable mode (hysteresis)")
                        override = pick_stable_winning_move(pvs) or override
                    elif mode == MODE_POISON:
                        say("☠ poison mode (hysteresis)")
                        override = pick_poison_move(pvs) or override
                    elif mode == MODE_ANNOY:
                        say("🪤 annoy mode (hysteresis)")
                        override = pick_annoying_losing_move(pvs) or override

                out(f"bestmove {override}")
                continue

            if line == "quit":
                break

            eng.send(line)

    finally:
        eng.close()

if __name__ == "__main__":
    main()
